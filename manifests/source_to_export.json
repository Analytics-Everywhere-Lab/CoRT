    {
      "edits": [
        {
          "after": "\"\"\"Audited token-component partitions for PatchAudit.\n\nThe module is intentionally standard-library-only.  It turns processor-proved\ntoken boundaries into an immutable partition receipt, factorial component\nunions, and deterministic candidate-crop cardinality controls.\n\"\"\"",
          "before": "\"\"\"Audited token-component partitions for PatchAudit Job E.\n\nThe module is intentionally standard-library-only.  It turns processor-proved\ntoken boundaries into an immutable partition receipt, factorial component\nunions, and deterministic candidate-crop cardinality controls.\n\"\"\"",
          "kind": "public_comment_edit"
        },
        {
          "after": "\"\"\"Build and prove the token-position component partition.\n\n    ``image_slot_positions`` must contain exactly three processor-proved sets:\n    the full-frame slot followed by the two candidate-crop slots.  The answer\n    prefix is the contiguous final ``answer_prefix_token_count`` active tokens,\n    matching the existing append-only answer-scoring contract.\n    \"\"\"",
          "before": "\"\"\"Build and prove the Job E token-component partition.\n\n    ``image_slot_positions`` must contain exactly three processor-proved sets:\n    the full-frame slot followed by the two candidate-crop slots.  The answer\n    prefix is the contiguous final ``answer_prefix_token_count`` active tokens,\n    matching the existing append-only answer-scoring contract.\n    \"\"\"",
          "kind": "public_comment_edit"
        },
        {
          "after": "# A concise alias for callers using the token-position ``position_partition`` style.",
          "before": "# A concise alias for callers that follow the Job D ``position_partition`` style.",
          "kind": "public_comment_edit"
        }
      ],
      "export_mode": "comment_docstring_edits",
      "export_path": "protocols/specifications/component_partition.py",
      "export_sha256": "905cc9de19671296c8af06ace182c7b269a6046fc07bcb34c8880874e7173f24",
      "included": true,
      "scientific_role": "Executable C/Q/P/R partition contract and deterministic crop-token sample rule.",
      "source_path": "research/lifecycle_memory/patchaudit_component_partition.py",
      "source_sha256": "e6a59fa7ac3c92288d6a0f7d30ac5d0997a239f5a63a87856b96fffc3c378191"
    },
    {
      "edits": [
        {
          "after": "\"\"\"Audited decoder transport operators for PatchAudit.\n\nThis module deliberately does not modify the frozen answer-token causal-patch\nengine. It reuses its tensor extraction and module-resolution contracts while\nadding explicit position-indexed capture, one-shot patches, and multi-layer\npersistent clamps.\n\"\"\"",
          "before": "\"\"\"Audited decoder transport operators for the PatchAudit follow-up.\n\nThis module deliberately does not modify the frozen Job C-R engine. It reuses\nits tensor extraction and module-resolution contracts while adding explicit\nposition-indexed capture, one-shot patches, and multi-layer persistent clamps.\n\"\"\"",
          "kind": "public_comment_edit"
        }
      ],
      "export_mode": "comment_docstring_edits",
      "export_path": "protocols/specifications/transport_operators.py",
      "export_sha256": "a522f15998e84eb19c28e40517d7bd50d1157d809b0fb367f9e9bf11bc76cfe2",
      "included": true,
      "scientific_role": "Executable transport operator semantics. Persistent clamp is retained as a frozen outcome condition but is structurally redundant in matched runs and does not test recontamination.",
      "source_path": "research/lifecycle_memory/patchaudit_transport_operators.py",
      "source_sha256": "73bfbbc64ff08f1c62590649f0ec45f1b52e9ec3adbecbd415598daf52f717e5"
